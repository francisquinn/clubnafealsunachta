---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import AccountForm from "../../components/AccountForm/AccountForm";
import { getSessionToken, verifySession } from "../../lib/auth";
import { supabaseAdmin } from "../../lib/supabase";

const token = getSessionToken(Astro.request);
const payload = await verifySession(token);

if (!payload) {
  return Astro.redirect("/");
}

// Independent lookups — the profile form must keep working even if the chapter
// subscription query fails, so each is its own query rather than one
// Promise.all that would sink all three together.
const [
  { data: member },
  { data: chapters },
  { data: memberships, error: membershipsError },
] = await Promise.all([
  supabaseAdmin
    ? supabaseAdmin.from("members").select("username, email, full_name, display_full_name, avatar_url").eq("id", payload.memberId).single()
    : Promise.resolve({ data: null }),
  supabaseAdmin
    ? supabaseAdmin.from("chapters").select("id, name, slug").order("name")
    : Promise.resolve({ data: null }),
  supabaseAdmin
    ? supabaseAdmin.from("chapter_members").select("chapter_id").eq("member_id", payload.memberId)
    : Promise.resolve({ data: null, error: null }),
]);

if (!member) {
  return Astro.redirect("/");
}

// A failed memberships lookup must not be treated as "no memberships": that
// would render every checkbox unchecked, and saving as-is (a full replace
// sync in updateChapterMemberships) would then wipe the member's real
// association. Hide the chapter section (chapters={[]} below) instead of guessing
// at its state — the rest of the form (username/password) still works.
if (membershipsError) console.error("Failed to load chapter memberships for profile edit:", membershipsError.message);
---

<BaseLayout pageTitle="Edit info">
  <section class="cnf-section">
    <div class="cnf-section__header">
      <h1>Edit info</h1>
      <a href="/profile">Back to profile</a>
    </div>
    <AccountForm
      client:load
      initialMemberId={payload.memberId}
      initialUsername={member.username}
      initialFullName={member.full_name}
      initialDisplayFullName={member.display_full_name}
      initialAvatarUrl={member.avatar_url}
      chapters={membershipsError ? [] : (chapters ?? [])}
      initialChapterIds={(memberships ?? []).map((membership) => membership.chapter_id)}
    />
  </section>
</BaseLayout>
