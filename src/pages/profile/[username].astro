---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getSessionToken, verifySessionToken } from "../../lib/auth";
import { supabaseAdmin } from "../../lib/supabase";
import { getDisplayName } from "../../lib/memberDisplay";
import BlogEntry from "../../components/BlogEntry.astro";
import Avatar from "../../components/Avatar/Avatar.astro";
import "../../styles/profile.css";

const { username } = Astro.params;

const token = getSessionToken(Astro.request);
const payload = token ? verifySessionToken(token) : null;

// Single query for the profile being viewed
const { data: profileUser } = await (supabaseAdmin
  ? supabaseAdmin.from("members").select("id, username, full_name, display_full_name, avatar_url, created_at").eq("username", username).single()
  : Promise.resolve({ data: null }));

if (!profileUser) {
  Astro.response.status = 404;
}

// Public, visible to any visitor — not gated on isOwnProfile. Hide the
// section on a lookup failure rather than showing an empty/wrong list, same
// posture as the edit page's club-section fallback.
let clubNames: string[] = [];
if (profileUser && supabaseAdmin) {
  const { data: memberships, error: membershipsError } = await supabaseAdmin
    .from("club_members")
    .select("club_id")
    .eq("member_id", profileUser.id);

  if (membershipsError) {
    console.error("Failed to load club memberships for profile page:", membershipsError.message);
  } else if (memberships && memberships.length > 0) {
    const { data: clubs, error: clubsError } = await supabaseAdmin
      .from("clubs")
      .select("name")
      .in("id", memberships.map((membership) => membership.club_id))
      .order("name");

    if (clubsError) {
      console.error("Failed to load clubs for profile page:", clubsError.message);
    } else {
      clubNames = (clubs ?? []).map((club) => club.name);
    }
  }
}

// Fetch only this user's posts directly from Supabase (1 query) instead of
// loading all posts via getCollection and filtering in memory.
let authoredPosts: { id: string; title: string; date: Date }[] = [];
if (profileUser && supabaseAdmin) {
  const { data: posts, error: postsError } = await supabaseAdmin
    .from("posts")
    .select("slug, title, date")
    .eq("author_id", profileUser.id)
    .order("date", { ascending: false });

  if (postsError) {
    console.error("Failed to load posts for profile page:", postsError.message);
  } else {
    authoredPosts = (posts ?? []).map((post) => ({
      id: post.slug,
      title: post.title,
      date: new Date(post.date),
    }));
  }
}

const displayName = profileUser ? getDisplayName(profileUser) : null;
const showHandle = profileUser ? displayName !== profileUser.username : false;

const memberSince = profileUser
  ? new Date(profileUser.created_at).toLocaleDateString("en-IE", { day: "numeric", month: "short", year: "numeric" })
  : null;

const isOwnProfile = Boolean(payload && profileUser && payload.username === profileUser.username);
---

<BaseLayout pageTitle={profileUser ? displayName : "Profile not found"}>
  {profileUser ? (
    <>
      <section class="cnf-section">
        <Avatar avatarUrl={profileUser.avatar_url} alt={displayName!} id={profileUser.id} size="lg" />
        <h1>{displayName}</h1>
        {showHandle && <p class="cnf-profile__handle">@{profileUser.username}</p>}
        <p>Member since: {memberSince}</p>
        {isOwnProfile && (
          <p><a href="/profile/edit">Edit your info</a></p>
        )}
      </section>

      {clubNames.length > 0 && (
        <section class="cnf-section">
          <h2>Memberships</h2>
          <ul class="cnf-club-badges">
            {clubNames.map((name) => (
              <li class="cnf-club-badge">{name}</li>
            ))}
          </ul>
        </section>
      )}

      {authoredPosts.length > 0 && (
        <section class="cnf-section">
          <h2>Posts</h2>
          <ul class="cnf-latest-blogs">
            {authoredPosts.map((post) => (
              <BlogEntry url={`/posts/${post.id}`} post={post} />
            ))}
          </ul>
        </section>
      )}
    </>
  ) : (
    <section class="cnf-section">
      <h1>Profile not found</h1>
      <p>No account exists with that username.</p>
    </section>
  )}
</BaseLayout>
