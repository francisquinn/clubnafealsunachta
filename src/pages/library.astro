---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { resizedImageUrl } from "../lib/storageUpload";
import { BOOK_COVER_RESIZE_WIDTH } from "../lib/bookCover";
import { sortBooksByTitle } from "../lib/bookOrder";

const books = sortBooksByTitle(await getCollection("books"));

const pageTitle = "Library";

// Covers render through Supabase's resizer rather than as full-size uploads
// (#141). Two widths for 1x/2x screens; cards are half the column on mobile
// and a third from 768px up.
const SRCSET_WIDTHS = [400, BOOK_COVER_RESIZE_WIDTH];
const COVER_SIZES = "(min-width: 768px) 33vw, 50vw";
// First row (3 columns on desktop) is above the fold, so it loads eagerly.
const EAGER_COVERS = 3;
const coverSrcset = (url: string) =>
  SRCSET_WIDTHS.map((width) => `${resizedImageUrl(url, width)} ${width}w`).join(", ");
---

<style>
  .cnf-library__intro {
    margin-bottom: 2.5rem;
  }

  ul {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media (min-width: 768px) {
    ul {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .cnf-book__cover {
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border-radius: 4px;
    box-shadow: var(--box-shadow-card);
    display: block;
  }

  /* Same press feedback as .cnf-button:active in global.css. */
  .cnf-book__cover-link {
    display: block;
    transition: transform 0.1s ease;
  }

  .cnf-book__cover-link:active {
    transform: scale(0.95);
  }
</style>

<BaseLayout pageTitle={pageTitle} description="Books Club na Fealsúnachta reads and recommends — a good place to start.">
  <section class="cnf-section">
    <h1>{pageTitle}</h1>
    <p class="cnf-library__intro">
      Books we've read and recommend in the club, a good place to start if
      you're curious what we're about. We'll keep adding new titles.
    </p>

    {books.length === 0 && (
      <p>No books listed yet — check back soon.</p>
    )}

    <ul>
      {books.map((book, index) => (
        <li>
          {book.data.coverImageUrl && (
            book.data.goodreadsUrl ? (
              <a
                class="cnf-book__cover-link"
                href={book.data.goodreadsUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                <img
                  class="cnf-book__cover"
                  src={resizedImageUrl(book.data.coverImageUrl, BOOK_COVER_RESIZE_WIDTH)}
                  srcset={coverSrcset(book.data.coverImageUrl)}
                  sizes={COVER_SIZES}
                  width={BOOK_COVER_RESIZE_WIDTH}
                  height={BOOK_COVER_RESIZE_WIDTH * 1.5}
                  alt={`${book.data.title} by ${book.data.author} — more on Goodreads`}
                  loading={index < EAGER_COVERS ? "eager" : "lazy"}
                />
              </a>
            ) : (
              <img
                class="cnf-book__cover"
                src={resizedImageUrl(book.data.coverImageUrl, BOOK_COVER_RESIZE_WIDTH)}
                srcset={coverSrcset(book.data.coverImageUrl)}
                sizes={COVER_SIZES}
                width={BOOK_COVER_RESIZE_WIDTH}
                height={BOOK_COVER_RESIZE_WIDTH * 1.5}
                alt={`Cover of ${book.data.title} by ${book.data.author}`}
                loading={index < EAGER_COVERS ? "eager" : "lazy"}
              />
            )
          )}
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
