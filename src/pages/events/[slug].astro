---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatEventDate } from "../../utils/script";
import "../../styles/event.css";
import { getCollection, render } from "astro:content";
import Banner from "../../layouts/Banner.astro";

export async function getStaticPaths() {
  const events = await getCollection("event");
  return events.map((event) => ({
    params: { slug: event.data.slug },
    props: { event },
  }));
}

const { event } = Astro.props;
const { Content } = await render(event);
---

<BaseLayout pageTitle={event.data.name}>
  <section class="cnf-section">
    <h1>{event.data.name}</h1>
    <div class="cnf-event-page__details">
      <span class="cnf-event-page__details-info"
        >{formatEventDate(new Date(event.data.date))}</span
      >
      <a
        href={event.data.location.url}
        class="cnf-event-page__details-link"
        target="_blank"
      >
        <img src="/map-pin.svg" />
        {event.data.location.name}
      </a>
      {
        event.data.debate ? (
          <span class="cnf-event-page__details-info">Debate</span>
        ) : (
          <span class="cnf-event-page__details-info">Discussion</span>
        )
      }
    </div>
    <Content />
    <div class="cnf-event-page__social">
      <h2>Social links</h2>
      <ul>
        {
          event.data.social.instagram && (
            <li>
              <a
                href={event.data.social.instagram}
                class="cnf-event-page__social-link"
                target="_blank"
              >
                <img class="cnf-event__social-svg" src="/instagram.svg" />
                Instagram
              </a>
            </li>
          )
        }
        {
          event.data.social.facebook && (
            <li>
              <a
                href={event.data.social.facebook}
                class="cnf-event-page__social-link"
                target="_blank"
              >
                <img class="cnf-event__social-svg" src="/facebook.svg" />
                Facebook
              </a>
            </li>
          )
        }
        {
          event.data.social.meetup && (
            <li>
              <a
                href={event.data.social.meetup}
                class="cnf-event-page__social-link"
                target="_blank"
              >
                <img class="cnf-event__social-svg" src="/meetup.svg" />
                Meetup
              </a>
            </li>
          )
        }
      </ul>
    </div>
  </section>
  <Banner
    title="Like to suggest a topic?"
    description="Why not help the never-ending list of topics grow even more!"
    location={{
      name: "Suggest topic",
      url: "/suggest-topic",
    }}
  />
</BaseLayout>
