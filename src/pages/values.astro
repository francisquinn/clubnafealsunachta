---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Our Values";

const values = [
  {
    title: "Curiosity",
    description:
      "We ask the bigger questions of life, not to settle on final answers or convince one another, but to enrich ourselves with each other's perspectives and keep exploring.",
  },
  {
    title: "Open-mindedness",
    description:
      "We listen to views different from our own, and stay open to being changed by them.",
  },
  {
    title: "Respect",
    description:
      "We hear each other out in a safe, friendly space, always challenging the argument, not the person.",
  },
  {
    title: "Community",
    description:
      "We bring together people from all walks of life, making real connections on topics that touch us all.",
  },
];
---

<style>
  .cnf-values__intro {
    max-width: 720px;
    margin-bottom: 2.5rem;
  }

  /* The intro's own gap (as on chapters and library) replaces the usual
     section gap before the first value. */
  .cnf-values__header {
    margin-bottom: 0;
  }

  /* One numbered list, so the values sit closer than separate sections
     would. The number goes before each title via a counter. */
  .cnf-values__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2rem;
    counter-reset: value;
  }

  .cnf-value {
    counter-increment: value;
  }

  /* Set here because an li's larger text would otherwise scale the
     heading up past other pages' h2. */
  .cnf-value h2 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .cnf-value h2::before {
    content: counter(value) ". ";
  }

  .cnf-value p {
    margin: 0;
  }
</style>

<BaseLayout
  pageTitle={pageTitle}
  description="The values Club na Fealsúnachta brings to every discussion: curiosity, open-mindedness, respect, and community."
>
  <section class="cnf-section cnf-values__header">
    <h1>{pageTitle}</h1>
    <p class="cnf-values__intro">
      These are the values we try to bring to every discussion, agreed on
      together as a club.
    </p>
  </section>
  <section class="cnf-section">
    <!-- role="list": Safari drops list semantics once list-style is none. -->
    <ol class="cnf-values__list" role="list">
      {values.map((value) => (
        <li class="cnf-value">
          <h2>{value.title}</h2>
          <p>{value.description}</p>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

