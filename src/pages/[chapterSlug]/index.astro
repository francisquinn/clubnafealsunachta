---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/event.css";
import UpcomingEvent from "../../components/UpcomingEvent";
import JoinChapterButton from "../../components/JoinChapterButton/JoinChapterButton";
import SubscribeCalendarLinks from "../../components/SubscribeCalendarLinks/SubscribeCalendarLinks";
import { getChapterEventsStaticPaths } from "../../lib/chapters";
import { getChapterContent } from "../../lib/chapterContent";

// One page per chapter, built from the same paths as the chapter's events page
// so the two always agree on which chapters exist.
export const getStaticPaths = getChapterEventsStaticPaths;

const { chapterSlug } = Astro.params;
const { chapter, events } = Astro.props;
const { description, photo, meeting, chatUrl, whatToExpect, social } = getChapterContent(chapterSlug!);
const chapterEvents = events.map((e) => e.data);
// Absolute, since calendar apps fetch the feed from outside the site.
const feedUrl = new URL(`/${chapterSlug}/events.ics`, Astro.site).href;
---

<style>
  .cnf-chapter-page__photo {
    aspect-ratio: 3 / 2;
    border-radius: var(--border-radius);
    box-shadow: var(--box-shadow-card);
    display: block;
    margin-bottom: 1.5rem;
    max-width: 720px;
    object-fit: cover;
    width: 100%;
  }

  .cnf-chapter-page__meeting {
    margin: 0;
  }

  .cnf-chapter-page__meeting dt {
    font-weight: 600;
  }

  .cnf-chapter-page__meeting dd {
    margin: 0 0 0.75rem;
  }

  .cnf-chapter-page__expect {
    margin: 0;
    max-width: 720px;
    padding-left: 1.25rem;
  }

  .cnf-chapter-page__expect li {
    margin-bottom: 0.5rem;
  }

  .cnf-chapter-page__social {
    display: flex;
    gap: 1.25rem;
    margin-top: 1rem;
  }

  .cnf-chapter-page__social-icon {
    height: 30px;
    width: 30px;
  }

  .cnf-chapter-page__join {
    margin-top: 1.5rem;
  }

  .cnf-chapter-page__chat {
    align-items: center;
    display: inline-flex;
    gap: 0.5rem;
  }

  .cnf-chapter-page__chat-icon {
    height: 1.5rem;
    width: 1.5rem;
  }
</style>

<BaseLayout pageTitle={chapter.name} description={description}>
  <section class="cnf-section">
    <h1>{chapter.name}</h1>
    <img class="cnf-chapter-page__photo" src={photo} alt="" />
  </section>
  <section class="cnf-section">
    {
      meeting && (
        <dl class="cnf-chapter-page__meeting">
          <dt>When</dt>
          <dd>{meeting.when}</dd>
          <dt>Where</dt>
          <dd><a href={meeting.whereUrl} target="_blank">{meeting.where}</a></dd>
        </dl>
      )
    }
    {
      chatUrl && (
        <a class="cnf-chapter-page__chat" href={chatUrl} target="_blank" rel="noopener">
          <img class="cnf-chapter-page__chat-icon" src="/whatsapp.svg" alt="" />
          Join the WhatsApp group
        </a>
      )
    }
    <div class="cnf-chapter-page__join">
      <JoinChapterButton chapterId={chapter.id} chapterName={chapter.name} client:load />
    </div>
  </section>
  {
    whatToExpect && (
      <section class="cnf-section">
        <h2>What to expect</h2>
        <ul class="cnf-chapter-page__expect">
          {whatToExpect.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </section>
    )
  }
  {
    social && (
      <section class="cnf-section">
        <h2>Follow us</h2>
        <div class="cnf-chapter-page__social">
          {social.map((link) => (
            <a href={link.href} target="_blank" rel="noopener" aria-label={link.name}>
              <img class="cnf-chapter-page__social-icon" src={link.icon} alt="" />
            </a>
          ))}
        </div>
      </section>
    )
  }
  <section class="cnf-section">
    <div class="cnf-section__header">
      <h2>Upcoming events</h2>
      <a href={`/${chapterSlug}/events`}>See all events</a>
    </div>
    <UpcomingEvent events={chapterEvents} responsive={true} client:load />
  </section>
  <section class="cnf-section">
    <SubscribeCalendarLinks feedUrl={feedUrl} chapterName={chapter.name} />
  </section>
</BaseLayout>
