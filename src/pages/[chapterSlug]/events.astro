---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
const pageTitle = "Events";
import "../../styles/event.css";
import "../../styles/select.css";
import EventList from "../../components/EventList/EventList";
import SubscribeCalendarLinks from "../../components/SubscribeCalendarLinks/SubscribeCalendarLinks";
import Banner from "../../layouts/Banner.astro";
import { getAllChapters, getChapterEventsStaticPaths, sortChaptersForPicker } from "../../lib/chapters";

// #39: chapters and events are resolved once for the whole build, and each
// chapter page gets its own pre-filtered list. Shared with the events.ics feed
// (#80) so the page and the feed list the same events.
export const getStaticPaths = getChapterEventsStaticPaths;

const { chapterSlug } = Astro.params;
const { chapter, events: sortedEvents } = Astro.props;
// Absolute, since calendar apps fetch the feed from outside the site.
const feedUrl = new URL(`/${chapterSlug}/events.ics`, Astro.site).href;
// #177: the chapter picker's options. getAllChapters is memoized per build, so
// this is no extra query.
const chapters = sortChaptersForPicker(await getAllChapters());
---

<BaseLayout pageTitle={pageTitle}>
  <section class="cnf-section">
    <h1>{pageTitle}</h1>
    <EventList events={sortedEvents} chapterSlug={chapterSlug!} chapters={chapters} client:load />
  </section>
  <section class="cnf-section">
    <SubscribeCalendarLinks feedUrl={feedUrl} chapterName={chapter.name} />
  </section>
  <Banner
    title="Like to suggest a topic?"
    description="Why not help the never-ending list of topics grow even more!"
    location={{
      name: "Suggest topic",
      url: "/suggest-topic",
    }}
  />
</BaseLayout>
