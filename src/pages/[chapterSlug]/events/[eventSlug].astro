---
export const prerender = true;
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { formatEventDate, formatEventEndTime, isEventExpired } from "../../../utils/script";
import { buildGoogleCalendarUrl, toEventIcsData } from "../../../lib/ics";
import "../../../styles/event.css";
import Banner from "../../../layouts/Banner.astro";
import EventRsvp from "../../../components/EventRsvp/EventRsvp";
import EventLiveActions from "../../../components/EventLiveActions/EventLiveActions";
import EventLocation from "../../../components/EventLocation/EventLocation";
import { getDisplayName } from "../../../lib/memberDisplay";
import Avatar from "../../../components/Avatar/Avatar.astro";
import { getEventChapterStaticPaths } from "../../../lib/chapters";
import { getTagLabel, normalizeTags } from "../../../lib/eventTags";

// #39: every event gets exactly one URL, under its chapter's prefix. Shared with
// [eventSlug].ics.ts so the two routes can't drift out of lockstep.
export const getStaticPaths = getEventChapterStaticPaths;

const { event } = Astro.props;
const { chapterSlug } = Astro.params;

// #28/#76: an "Add to calendar" dropdown for upcoming events (Google Calendar
// / Apple Calendar), built at build time from the same normalized event data
// the page renders. Google gets a real deep link — no file, no MIME
// sniffing. Apple/Outlook-desktop/everything-else gets a real same-origin
// .ics file at [eventSlug].ics.ts (kept as a separate static route in
// lockstep with this page's own getStaticPaths) rather than a `data:` URI —
// WebKit blocks top-level navigation to `data:` URLs, which silently broke
// "Apple Calendar" in real iOS Safari (#76). AddToCalendarButton still keeps
// a `download` filename for every browser except real Safari (confirmed live
// 2026-09-04: without it, Chrome saves a generic "download.ics") — that part
// is unaffected by the swap since it works the same on a real URL. Past
// events get no button at build; #197: EventLiveActions then refreshes from
// live data on hydration (both directions).
const isCalendarVisible = !isEventExpired(event.data);
const icsEventData = toEventIcsData(event);
const icsHref = `/${chapterSlug}/events/${event.data.slug}.ics`;
const icsFilename = `${event.data.slug}.ics`;
const googleCalendarUrl = buildGoogleCalendarUrl(icsEventData);
// Normalized so tags always show alphabetically, and ones off the fixed list
// (e.g. old free-text tags) are skipped.
const tagLabels = normalizeTags(event.data.tags ?? []).flatMap((slug) => getTagLabel(slug) ?? []);
---

<BaseLayout
  pageTitle={event.data.name}
  description={event.data.description ?? `Join Club na Fealsúnachta for ${event.data.name}.`}
>
  <section class="cnf-section">
    <h1>{event.data.name}</h1>
    <div class="cnf-event-page__details">
      <span class="cnf-event-page__details-info"
        >{formatEventDate(new Date(event.data.date))}–{formatEventEndTime(new Date(event.data.endDate))}</span
      >
      <EventLocation
        slug={event.data.slug}
        isOnline={event.data.isOnline}
        meetingUrl={event.data.meetingUrl}
        venue={event.data.venue}
        client:load
      />
    </div>
    {event.data.description && (
      <div class="cnf-event-page__description">
        <h2>Description</h2>
        <p>{event.data.description}</p>
      </div>
    )}
    {event.data.summary && (
      <div class="cnf-event-page__summary">
        <h2>Summary</h2>
        <p>{event.data.summary}</p>
      </div>
    )}
    {tagLabels.length > 0 && (
      <div class="cnf-event-page__tags">
        {tagLabels.map((label) => <span class="cnf-badge">{label}</span>)}
      </div>
    )}
    <div class="cnf-event-page__details">
      <span class="cnf-event-page__details-info"
        ><Avatar avatarUrl={event.data.creator.avatar_url} alt={getDisplayName(event.data.creator)} id={event.data.creator.id} size="sm" /> Hosted by <a href={`/profile/${event.data.creator.username}`}>{getDisplayName(event.data.creator)}</a></span
      >
    </div>
    <div class="cnf-event-page__details">
      <EventLiveActions
        slug={event.data.slug}
        visibleAtBuild={isCalendarVisible}
        endDate={event.data.endDate}
        isOnline={event.data.isOnline}
        meetingUrl={event.data.meetingUrl}
        icsHref={icsHref}
        icsFilename={icsFilename}
        googleUrl={googleCalendarUrl}
        client:load
      />
    </div>
  </section>

  <section class="cnf-section">
    <EventRsvp
      slug={event.data.slug}
      initialCounts={event.data.rsvpCounts}
      date={event.data.date.toISOString()}
      client:load
    />
  </section>

  {event.data.meetPoint && !event.data.isOnline && (
    <section class="cnf-section">
      <h2>Meet point</h2>
      {
        event.data.venue?.url ? (
          <a href={event.data.venue.url} class="cnf-event-page__details-link" target="_blank">
            <img src="/map-pin.svg" />
            {event.data.venue.name}
          </a>
        ) : (
          event.data.venue?.name && (
            <span class="cnf-event-page__details-info">{event.data.venue.name}</span>
          )
        )
      }
      <p>{event.data.meetPoint}</p>
    </section>
  )}

  {(event.data.social.instagram || event.data.social.facebook || event.data.social.meetup) && (
    <section class="cnf-section">
      <div class="cnf-event-page__social">
        <h2>Social links</h2>
        <ul>
          {
            event.data.social.instagram && (
              <li>
                <a
                  href={event.data.social.instagram}
                  class="cnf-event-page__social-link"
                  target="_blank"
                >
                  <img class="cnf-event__social-svg" src="/instagram.svg" />
                  Instagram
                </a>
              </li>
            )
          }
          {
            event.data.social.facebook && (
              <li>
                <a
                  href={event.data.social.facebook}
                  class="cnf-event-page__social-link"
                  target="_blank"
                >
                  <img class="cnf-event__social-svg" src="/facebook.svg" />
                  Facebook
                </a>
              </li>
            )
          }
          {
            event.data.social.meetup && (
              <li>
                <a
                  href={event.data.social.meetup}
                  class="cnf-event-page__social-link"
                  target="_blank"
                >
                  <img class="cnf-event__social-svg" src="/meetup.svg" />
                  Meetup
                </a>
              </li>
            )
          }
        </ul>
      </div>
    </section>
  )}
  <Banner
    title="Like to suggest a topic?"
    description="Why not help the never-ending list of topics grow even more!"
    location={{
      name: "Suggest topic",
      url: "/suggest-topic",
    }}
  />
</BaseLayout>
