---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogPost from "../components/BlogPost.astro";
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const pageTitle = "Blog";
---

<style>
  .cnf-blogs__info {
    text-align: justify;
  }
</style>

<BaseLayout pageTitle={pageTitle}>
  <section id="blogs">
    <h1>{pageTitle}</h1>
    <p class="cnf-blog__info">
      Welcome to the Club na Fealsúnachta blog page! Here is where I'll write
      about various topics and arguments that interest me.
    </p>
    <ul>
      {
        posts.map((post: any) => (
          <BlogPost url={`/posts/${post.id}`} post={post.data} />
        ))
      }
    </ul>
  </section>
</BaseLayout>
