---
export const prerender = true;
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatBlogDate } from "../../utils/script";
import Banner from "../../layouts/Banner.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<style>
  .cnf-post__details {
    font-size: 1rem;
    color: hsl(var(--color-grey));
  }
</style>

<BaseLayout
  pageTitle={post.data.title}
  description={`${post.data.title} — Club na Fealsúnachta blog.`}
  ogType="article"
>
  <section class="cnf-section">
    <h1>{post.data.title}</h1>
    <div class="cnf-post__details">
      {post.data.author} &#8226; {formatBlogDate(post.data.date)}
    </div>
    <Content />
  </section>
  <Banner
    title="Fancy supporting the club?"
    description="If you're enjoying what we're at, why not chip in and help keep things going!"
    location={{
      name: "Supply the tea",
      url: "https://ko-fi.com/clubnafealsunachta",
      isExternal: true,
    }}
  />
</BaseLayout>
