---
export const prerender = true;
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatBlogDate } from "../../utils/script";
import { getDisplayName } from "../../lib/memberDisplay";
import Avatar from "../../components/Avatar/Avatar.astro";
import Banner from "../../layouts/Banner.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<style>
  .cnf-post__details {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    color: hsl(var(--color-grey));
  }

  /* Blog post content images — responsive, lazy-loaded, centered */
  :global(img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 1.5rem auto;
  }
</style>

<BaseLayout
  pageTitle={post.data.title}
  description={`${post.data.title} — Club na Fealsúnachta blog.`}
  ogType="article"
>
  <section class="cnf-section">
    <h1>{post.data.title}</h1>
    <div class="cnf-post__details">
      <Avatar avatarUrl={post.data.author.avatar_url} alt={getDisplayName(post.data.author)} id={post.data.author.id} size="sm" />
      <a href={`/profile/${post.data.author.username}`}>{getDisplayName(post.data.author)}</a> &#8226; {formatBlogDate(post.data.date)}
    </div>
    <Content />
  </section>
  <Banner
    title="Fancy supporting the club?"
    description="If you're enjoying what we're at, why not chip in and help keep things going!"
    location={{
      name: "Supply the tea",
      url: "https://ko-fi.com/clubnafealsunachta",
      isExternal: true,
    }}
  />
</BaseLayout>
