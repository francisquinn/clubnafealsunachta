---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getAllChapters, sortChaptersForPicker } from "../lib/chapters";
import { getChapterContent } from "../lib/chapterContent";

const pageTitle = "Chapters";
// getAllChapters is memoized per build, so this is no extra query.
const chapters = sortChaptersForPicker(await getAllChapters());
---

<style>
  .cnf-chapters__intro {
    max-width: 720px;
    margin-bottom: 2.5rem;
  }

  .cnf-chapters__list {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cnf-chapter__photo {
    aspect-ratio: 3 / 2;
    border-radius: var(--border-radius);
    box-shadow: var(--box-shadow-card);
    display: block;
    margin-bottom: 1.25rem;
    object-fit: cover;
    width: 100%;
  }

  .cnf-chapter__link {
    color: inherit;
    display: block;
    text-decoration: none;
    transition: transform ease-in-out 0.2s;
  }

  /* Same lift as the event cards (event.css). */
  .cnf-chapter__link:hover {
    transform: translate(0, -3px);
  }

  .cnf-chapter__name {
    margin: 0 0 0.5rem;
  }
</style>

<BaseLayout pageTitle={pageTitle}>
  <section class="cnf-section">
    <h1>{pageTitle}</h1>
    <p class="cnf-chapters__intro">
      Club na Fealsúnachta meets in chapters, each a group in one city with
      its own events. Can't make it in person? Join the Online chapter from
      anywhere.
    </p>
    <ul class="cnf-chapters__list">
      {
        chapters.map((chapter) => (
          <li class="cnf-chapter">
            <a class="cnf-chapter__link" href={`/${chapter.slug}/`}>
              <img
                class="cnf-chapter__photo"
                src={getChapterContent(chapter.slug).photo}
                alt=""
              />
              <h2 class="cnf-chapter__name">{chapter.name}</h2>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
