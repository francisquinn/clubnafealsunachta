---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import ResetPasswordForm from "../components/ResetPasswordForm/ResetPasswordForm";
import "../styles/form.css";

const token = Astro.url.searchParams.get("token");
---

<BaseLayout pageTitle="Reset password">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <meta slot="head" name="referrer" content="no-referrer" />
  <section class="cnf-section cnf-section--narrow">
    <h1>Reset password</h1>
    {
      token ? (
        <ResetPasswordForm client:load token={token} />
      ) : (
        <>
          <p>This reset link is invalid or has expired. Use "Forgot your password?" in the login window to request a new one.</p>
          <p><a href="/">Back to homepage</a></p>
        </>
      )
    }
  </section>
</BaseLayout>
