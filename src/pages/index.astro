---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import UpcomingEvent from "../components/UpcomingEvent";
import LatestPost from "../components/LatestPost.astro";
import { getCollection } from "astro:content";
import type { EventCollection } from "../types/types";
import { isEventExpired } from "../utils/script";

const events = await getCollection("event") as EventCollection[];
const currentEvent = events
  .filter((e) => !isEventExpired(e.data))
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())[0];

const pageTitle = "Home";
---

<BaseLayout pageTitle={pageTitle}>
  <Hero />
  <section class="cnf-section">
    <h2>Upcoming events in Trieste</h2>
    {
      currentEvent
        ? <UpcomingEvent event={currentEvent.data} responsive={true} client:load />
        : <p>No upcoming events at the moment. Stay tuned for further updates!</p>
    }
  </section>
  <LatestPost />
</BaseLayout>
