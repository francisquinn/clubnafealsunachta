---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import UpcomingEvent from "../components/UpcomingEvent";
import SeeAllEventsLink from "../components/SeeAllEventsLink/SeeAllEventsLink";
import LatestPost from "../components/LatestPost.astro";
import { getCollection } from "astro:content";
import { getAllChapters } from "../lib/chapters";
import type { EventCollection } from "../types/types";

const events = (await getCollection("event")) as EventCollection[];
const sorted = events.sort(
  (a, b) => a.data.date.getTime() - b.data.date.getTime(),
);
const lastPastIndex = sorted.findLastIndex((e) => e.data.date <= new Date());
const allEvents = sorted
  .slice(Math.max(0, lastPastIndex), lastPastIndex + 3)
  .map((e) => e.data);

// #194: only a still-existing chapter may be linked to (a stale stored slug
// would 404). getAllChapters is memoized per build.
const chapterSlugs = (await getAllChapters()).map((c) => c.slug);

const pageTitle = "Home";
const description = "A philosophy discussion club meeting in Trieste, Italy.";
---

<BaseLayout pageTitle={pageTitle} description={description}>
  <Hero />
  <section class="cnf-section">
    <div class="cnf-section__header">
      <h2>Upcoming events</h2>
      <SeeAllEventsLink chapterSlugs={chapterSlugs} client:load />
    </div>
    <UpcomingEvent events={allEvents} responsive={true} client:load />
  </section>
  <LatestPost />
</BaseLayout>
