---
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle = "About";
---

<style>
  .cnf-about {
    text-align: center;
  }

  .cnf-about__image {
    border-radius: 20px;
    max-width: 450px;
  }

  .cnf-about__info {
    margin-bottom: 3rem;
    text-align: left;
  }
</style>

<BaseLayout pageTitle={pageTitle}>
  <section id="about">
    <h1>{pageTitle}</h1>
    <div class="cnf-about">
      <div class="cnf-about__info">
        <p>
          Club na Fealsúnachta <i>(pronounced klub nuh fal-SOO-nukh-tuh)</i>,
          which translates to "Philosophy Club" in Irish Gaelic, was founded in
          2024 by Francis Quinn in the city of Trieste. The idea behind the club
          is to bring people together to engage in weekly thought-provoking
          philosophical discussions that aim not to find the answers, but spark
          the curiosity to listen and question other opinions in a safe and
          friendly environment.
        </p>
        <p>
          The club is primarily in-person based in Trieste, Italy, but with
          plans in the future to eventually spread to a wider audience.
        </p>
        <p>
          If you're interested in the club and would like to find out more
          information or collaborate feel free to <a
            href="mailto:clubnafealsunachta@gmail.com"
            target="_blank">contact me</a
          >.
        </p>
        <p>Francis.</p>
      </div>
      <img class="cnf-about__image" src="/about.jpeg" width="100%" />
    </div>
  </section>
</BaseLayout>
