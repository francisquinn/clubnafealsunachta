---
export const prerender = false;
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import EventForm from "../../../../components/EventForm/EventForm";
import type { EventFormInitialData } from "../../../../components/EventForm/EventForm";
import { supabase } from "../../../../lib/supabase";
import { requireAdmin, isChapterInScope } from "../../../../lib/auth";
import { unwrapRelation } from "../../../../lib/supabaseRelations";
import { utcToLocalWallTime } from "../../../../lib/timezone";
import { DEFAULT_CHAPTER_TIMEZONE } from "../../../../lib/chapterDefaults";
import "../../../../styles/form.css";

// #37: a chapter-scoped admin may only edit events in their own chapters (Online
// included for every chapter admin, #177) - checked below.
const admin = (await requireAdmin(Astro.request))!;

const { slug } = Astro.params;

const { data: event, error } = await supabase!
  .from("events")
  .select("id, name, date, end_date, slug, is_online, venue_id, chapter_id, meeting_url, instagram, facebook, meetup, description, summary, tags, venues(id, name, url)")
  .eq("slug", slug!)
  .single();

// A chapter-scoped admin has no standing to even view an event outside their
// chapters, not just to save changes to it (updateEvent already enforces that
// side) - same redirect as a genuinely missing event, no distinct "forbidden"
// state to avoid confirming a slug's existence to an admin who can't see it.
if (error || !event || !isChapterInScope(admin, event.chapter_id)) {
  return Astro.redirect("/admin/events");
}

// The datetime-local input needs the chapter's own local wall-clock time, not
// raw UTC (see src/lib/timezone.ts) — event.date is now a true UTC instant,
// so this has to convert back rather than just slicing the ISO string.
const dateStr = utcToLocalWallTime(new Date(event.date), DEFAULT_CHAPTER_TIMEZONE);
const endDateStr = utcToLocalWallTime(new Date(event.end_date), DEFAULT_CHAPTER_TIMEZONE);

const venue = unwrapRelation(event.venues);

const initialData: EventFormInitialData = {
  name: event.name,
  date: dateStr,
  endDate: endDateStr,
  slug: event.slug,
  isOnline: event.is_online,
  venueId: venue?.id,
  meetingUrl: event.meeting_url ?? undefined,
  instagram: event.instagram ?? undefined,
  facebook: event.facebook ?? undefined,
  meetup: event.meetup ?? undefined,
  description: event.description ?? undefined,
  summary: event.summary ?? undefined,
  tags: event.tags ?? [],
};
---

<AdminLayout pageTitle={`Edit: ${event.name}`}>
  <section class="cnf-section">
    <div class="cnf-admin-header">
      <h1>Edit event</h1>
      <a href="/admin/events">Back to events</a>
    </div>
    <EventForm mode="edit" initialData={initialData} client:load />
  </section>
</AdminLayout>
