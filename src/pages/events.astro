---
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle = "Events";
import "../styles/event.css";
import "../styles/select.css";
import EventList from "../components/EventList/EventList";
import { getCollection } from "astro:content";
import type { EventCollection } from "../types/types";
import Banner from "../layouts/Banner.astro";

const sortedEvents = (await getCollection("event")) as EventCollection[];
---

<BaseLayout pageTitle={pageTitle}>
  <section class="cnf-section">
    <h1>{pageTitle}</h1>
    <EventList events={sortedEvents} client:load />
  </section>
  <Banner
    title="Like to suggest a topic?"
    description="Why not help the never-ending list of topics grow even more!"
    location={{
      name: "Suggest topic",
      url: "/suggest-topic",
    }}
  />
</BaseLayout>
