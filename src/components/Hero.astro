---

<style>
  h1 {
    color: var(--green);
    font-family: "Uncial Antiqua";
    font-size: 1.75rem;
    margin: 0.5rem 0 1rem 0;
  }

  #hero {
    text-align: center;
    padding-bottom: 5rem;
    position: relative;
  }

  .cnf-hero__content {
    padding: 0 1rem;
  }

  .cnf-hero__logo {
    position: absolute;
    z-index: -1;
    top: 150px;
    right: -120px;
  }

  .cnf-hero__logo--svg {
    width: 400px;
    height: 400px;
    opacity: 0.08;
  }

  .cnf-hero__links {
    width: 60%;
    margin: 0 auto;
    margin-top: 2rem;
  }

  .cnf-hero__social {
    display: flex;
    justify-content: space-evenly;
    gap: 40px;
    margin-top: 2rem;
  }

  .cnf-hero__social--link {
    display: inline-block;
  }

  .cnf-hero__social--svg {
    pointer-events: none;
    width: 50px;
    height: 50px;
  }

  /* small */
  @media (min-width: 576px) {
    #hero {
      text-align: start;
      width: 90%;
      margin: 0 auto;
    }

    .cnf-hero__logo {
      right: 0;
      left: auto;
      top: auto;
      transform: none;
    }

    .cnf-hero__logo--svg {
      width: 500px;
      height: 500px;
    }

    .cnf-hero__content {
      width: 90%;
    }

    .cnf-hero__links {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 24px;
      width: 100%;
    }

    .cnf-hero__social {
      display: block;
      margin-top: 0;
    }

    .cnf-hero__social--link {
      margin-right: 1rem;
    }
  }

  /* medium */
  @media (min-width: 768px) {
    #hero {
      width: 85%;
    }

    .cnf-hero__content {
      width: 75%;
    }

    .cnf-hero__content--heading {
      font-size: 2rem;
    }

    .cnf-hero__social--link {
      margin-right: 1.5rem;
    }
  }

  /* large */
  @media (min-width: 992px) {
    #hero {
      width: 75%;
    }

    .cnf-hero__content--heading {
      font-size: 2.25rem;
    }

    .cnf-hero__logo--svg {
      width: 550px;
      height: 550px;
    }
  }

  /* extra large */
  @media (min-width: 1200px) {
    #hero {
      width: 70%;
    }

    .cnf-hero__content {
      width: 65%;
    }

    .cnf-hero__content--heading {
      font-size: 2.5rem;
    }

    .cnf-hero__logo--svg {
      width: 600px;
      height: 600px;
    }
  }

  @media (min-width: 1620px) {
    #hero {
      width: 60%;
    }

    .cnf-hero__content {
      width: 60%;
    }

    .cnf-hero__content--heading {
      font-size: 3rem;
    }

    .cnf-hero__logo--svg {
      width: 650px;
      height: 650px;
    }
  }
</style>

<section id="hero">
  <div class="cnf-hero__logo">
    <img class="cnf-hero__logo--svg" src="/cnf-logo.svg" />
  </div>
  <div class="cnf-hero__content">
    <h1 class="cnf-hero__content--heading">Club na Fealsúnachta</h1>
    <p>
      Join us for thought-provoking philosophical discussions—no experience
      needed, just curiosity and an open mind!
    </p>
    <div class="cnf-hero__links">
      <a href="mailto:clubnafealsunachta@gmail.com">
        <button class="cnf-button cnf-button__primary">Get in touch!</button>
      </a>

      <div class="cnf-hero__social">
        <a
          href="https://www.instagram.com/clubnafealsunachta/"
          class="cnf-hero__social--link"
          target="_blank"
        >
          <img class="cnf-hero__social--svg" src="/instagram.svg" /></a
        >
        <a
          href="https://www.facebook.com/people/Club-na-Fealsúnachta/61578150433186/"
          class="cnf-hero__social--link"
          target="_blank"
          ><img class="cnf-hero__social--svg" src="/facebook.svg" /></a
        >
      </div>
    </div>
  </div>
</section>
