---
import LoginButton from "./LoginButton/LoginButton";
import NavMenu from "./NavMenu/NavMenu";
import AccountMenu from "./AccountMenu/AccountMenu";
const { pathname } = Astro.url;
---

<header>
  <nav class="cnf-nav">
    <div class="cnf-nav__brand">
      <a class="cnf-nav__link" href="/">
        <img class="cnf-nav__link--svg" src="/cnf-logo.svg" />
      </a>
    </div>
    <div class="cnf-auth">
      <div class="cnf-auth__logout">
        <AccountMenu client:load pathname={pathname} />
      </div>
      <button
        type="button"
        id="cnf-login-trigger"
        class="cnf-button cnf-button__secondary cnf-button--compact cnf-auth__login"
      >
        <span class="cnf-button__text">Login</span>
      </button>
    </div>
    <LoginButton client:load />
    <NavMenu client:load pathname={pathname} />
  </nav>
</header>
