<style>
  .cnf-event {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: 150px 1fr;
    align-items: center;
    border-radius: 20px;
    box-shadow: rgba(0, 0, 0, 0.15) 0px 5px 15px 0px;
  }

  h3 {
    margin: 0;
    color: var(--green);
    font-family: "Uncial Antiqua";
    font-size: 1.5rem;
  }

  .cnf-event__poster {
    display: flex;
    width: 100%;
    height: 100%;
    padding: 0 1rem;
    align-items: center;
    justify-content: center;
  }

  .cnf-event__info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding: 1rem;
    background-color: #fffcf9;
    border-radius: 0 0 20px 20px;
  }

  .cnf-event__social {
    margin-top: 0.75rem;
  }

  .cnf-event__location {
    margin-top: 0.25rem;
  }

  .cnf-event__social--svg {
    margin-right: 1rem;
    width: 30px;
    height: 30px;
  }

  .cnf-event__dialog {
    text-align: center;
  }

  ul {
    margin: 0;
  }

  @media (min-width: 480px) {
    .cnf-event {
      grid-template-columns: auto 1fr;
      grid-template-rows: 1fr;
    }

    .cnf-event__poster {
      grid-column: 1 / 2;
    }

    .cnf-event__info {
      grid-column: 2 / 3;
      border-radius: 0 20px 20px 0;
    }
  }
</style>

<section id="events">
  <h2>Upcoming events</h2>
  <div class="cnf-event">
    <div class="cnf-event__poster">
      <h3>Striving for perfection</h3>
    </div>
    <div class="cnf-event__info">
      <ul>
        <li>Thur 30 Jul at 18</li>
        <!-- <li><h3>what makes us human?</h3></li> -->
        <li class="cnf-event__location">
          <a href="https://maps.app.goo.gl/ZQMv8Jczdzbh4p8ZA" target="_blank">
            Polo Toti Youth Center</a
          >
        </li>
        <li>
          <div class="cnf-event__social">
            <a
              href="https://www.instagram.com/clubnafealsunachta/"
              class="cnf-event__social--link"
              target="_blank"
            >
              <object
                class="cnf-event__social--svg"
                data="/instagram.svg"
                type="image/svg+xml"></object></a
            >
            <a
              href="https://www.facebook.com/people/Club-na-Fealsúnachta/61578150433186/"
              class="cnf-event__social--link"
              target="_blank"
              ><object
                class="cnf-event__social--svg"
                data="/facebook.svg"
                type="image/svg+xml"></object></a
            >
            <a
              href="https://www.instagram.com/clubnafealsunachta/"
              class="cnf-event__social--link"
              target="_blank"
            >
              <object
                class="cnf-event__social--svg"
                data="/meetup.svg"
