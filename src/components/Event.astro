---
import events from "../../events.json";
const currentEvent = events[0];
---

<style>
  .cnf-event {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: 150px 1fr;
    align-items: center;
    border-radius: 20px;
    box-shadow: rgba(0, 0, 0, 0.15) 0px 5px 15px 0px;
  }

  h3 {
    margin: 0;
    color: var(--green);
    font-family: "Uncial Antiqua";
    font-size: 1.5rem;
  }

  .cnf-event__poster {
    display: flex;
    width: 100%;
    height: 100%;
    padding: 0 1rem;
    align-items: center;
    justify-content: center;
  }

  .cnf-event__info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding: 1rem;
    background-color: #fffcf9;
    border-radius: 0 0 20px 20px;
  }

  .cnf-event__social {
    margin-top: 0.75rem;
  }

  .cnf-event__location {
    margin-top: 0.25rem;
  }

  .cnf-event__social--svg {
    margin-right: 1rem;
    width: 30px;
    height: 30px;
  }

  .cnf-event__dialog {
    text-align: center;
  }

  ul {
    margin: 0;
  }

  @media (min-width: 768px) {
    .cnf-event {
      grid-template-columns: auto fit-content;
      grid-template-rows: 1fr;
    }

    .cnf-event__poster {
      grid-column: 1 / 2;
    }

    .cnf-event__info {
      grid-column: 2 / 3;
      border-radius: 0 20px 20px 0;
    }
  }
</style>

<section id="events">
  <h2>Upcoming events</h2>
  <div class="cnf-event">
    <div class="cnf-event__poster">
      <h3>{currentEvent.name}</h3>
    </div>
    <div class="cnf-event__info">
      <ul>
        <li>{currentEvent.date}</li>
        <li class="cnf-event__location">
          <a href={currentEvent.map_url} target="_blank">
            {currentEvent.location}</a
          >
        </li>
        <li>
          <div class="cnf-event__social">
            <a
              href="https://www.instagram.com/clubnafealsunachta/"
              class="cnf-event__social--link"
              target="_blank"
            >
              <img class="cnf-event__social--svg" src="/instagram.svg" /></a
            >
            <a
              href="https://www.facebook.com/people/Club-na-Fealsúnachta/61578150433186/"
              class="cnf-event__social--link"
              target="_blank"
              ><img class="cnf-event__social--svg" src="/facebook.svg" /></a
            >
            {
              currentEvent.meetup && (
                <a
                  href="https://www.instagram.com/clubnafealsunachta/"
                  class="cnf-event__social--link"
                  target="_blank"
                >
                  <img class="cnf-event__social--svg" src="/meetup.svg" />
                </a>
              )
            }
          </div>
        </li>
      </ul>
    </div>
  </div>
</section>
