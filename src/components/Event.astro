---
import events from "../../events.json";
import { formatEventDate } from "../utils/script";
const currentEvent = events[0];
const borderRadius = "20px";
---

<style define:vars={{ borderRadius }}>
  .cnf-event {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: 150px 1fr;
    border-radius: var(--borderRadius);
    box-shadow: rgba(0, 0, 0, 0.15) 0px 5px 15px 0px;
  }

  h3 {
    margin: 0;
    color: var(--green);
    font-family: "Uncial Antiqua";
    font-size: 1.5rem;
  }

  .cnf-event__poster {
    display: flex;
    padding: 0 1rem;
    align-items: center;
    text-align: center;
    justify-content: center;
    background-color: var(--beige);
    border-radius: var(--borderRadius) 0 0 var(--borderRadius);
  }

  .cnf-event__info {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    padding: 1rem;
    background-color: var(--white);
    border-radius: 0 0 var(--borderRadius) var(--borderRadius);
  }

  .cnf-event__date {
    font-size: 1rem;
    color: var(--grey);
  }

  .cnf-event__social {
    display: flex;
    justify-content: space-around;
    margin-top: 0.75rem;
  }

  .cnf-event__location {
    margin-top: 0.25rem;
  }

  .cnf-event__social--svg {
    width: 30px;
    height: 30px;
  }

  ul {
    margin: 0;
  }

  @media (min-width: 576px) {
    .cnf-event {
      grid-template-columns: 1fr auto;
      grid-template-rows: 1fr;
    }

    .cnf-event__poster {
      grid-column: 1 / 2;
    }

    .cnf-event__info {
      display: block;
      grid-column: 2 / 3;
      border-radius: 0 var(--borderRadius) var(--borderRadius) 0;
    }

    .cnf-event__social {
      justify-content: space-between;
    }
  }
</style>

<section id="events">
  <h2>Upcoming event</h2>
  <div class="cnf-event">
    <div class="cnf-event__poster">
      <h3>{currentEvent.name}</h3>
    </div>
    <div class="cnf-event__info">
      <div>
        <ul>
          <li class="cnf-event__date">
            {formatEventDate(new Date(currentEvent.date))}
          </li>
          <li class="cnf-event__location">
            <a href={currentEvent.map_url} target="_blank">
              {currentEvent.location}</a
            >
          </li>
        </ul>
      </div>
      <div class="cnf-event__social">
        <a
          href={currentEvent.links.instagram}
          class="cnf-event__social--link"
          target="_blank"
        >
          <img class="cnf-event__social--svg" src="/instagram.svg" /></a
        >
        <a
          href={currentEvent.links.facebook}
          class="cnf-event__social--link"
          target="_blank"
          ><img class="cnf-event__social--svg" src="/facebook.svg" /></a
        >
        {
          currentEvent.links.meetup.length > 0 && (
            <a
              href={currentEvent.links.meetup}
              class="cnf-event__social--link"
              target="_blank"
            >
              <img class="cnf-event__social--svg" src="/meetup.svg" />
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>
