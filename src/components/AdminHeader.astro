---
import AccountMenu from "./AccountMenu/AccountMenu";
const { pathname } = Astro.url;
---

<style>
  .cnf-nav__brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .cnf-admin-account {
    position: relative;
  }
</style>

<header>
  <nav class="cnf-nav">
    <div class="cnf-nav__brand">
      <a class="cnf-nav__link" href="/admin/">
        <img class="cnf-nav__link--svg" src="/cnf-logo.svg" />
      </a>
      <a class="cnf-nav__link cnf-nav__admin-label" href="/admin/">Admin</a>
    </div>
    <div class="cnf-admin-account">
      <AccountMenu client:load pathname={pathname} />
    </div>
  </nav>
</header>
