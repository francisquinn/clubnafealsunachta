---
import { getCollection } from "astro:content";
import BlogPost from "./BlogPost.astro";
const latestBlogEntries = (await getCollection("blog"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
---

<section class="cnf-section">
  <div class="cnf-section__header">
    <h2>Latest blog posts</h2>
    <a href="/blog">See all posts</a>
  </div>
  <ul class="cnf-events--grid cnf-latest-posts__list">
    {
      latestBlogEntries.map((post) => (
        <BlogPost url={`/posts/${post.id}`} post={post.data} />
      ))
    }
  </ul>
</section>

<style>
  .cnf-latest-posts__list {
    margin: 0;
    padding: 0;
  }
</style>
