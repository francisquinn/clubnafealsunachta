---
const year = new Date().getFullYear();
---

<style>
  .cnf-footer {
    display: grid;
    justify-items: center;
    grid-template-columns: 1fr;
    grid-template-rows: repeat(3, auto);
    row-gap: 1.25rem;
    padding: 1rem;
    width: 100%;
  }

  .cnf-footer__social {
    display: flex;
    justify-content: space-between;
    margin-top: 0.75rem;
    max-width: 200px;
    width: 100%;
  }

  .cnf-footer__social-svg {
    width: 30px;
    height: 30px;
  }

  .cnf-footer__links {
    display: flex;
    justify-content: space-around;
    width: 100%;
    max-width: 400px;
  }

  .cnf-footer__sign {
    color: hsl(var(--color-grey));
  }

  .cnf-footer__icon {
    width: 0.8rem;
    height: 0.8rem;
  }
</style>

<footer class="cnf-footer">
  <div class="cnf-footer__links">
    <a href="https://ko-fi.com/clubnafealsunachta" target="_blank">
      Support
      <img class="cnf-footer__icon" src="/link.svg" />
    </a>
    <a href="/newsletter">Newsletter</a>
    <a href="mailto:info@clubnafealsunachta.com" target="_blank">Contact</a>
  </div>
  <div class="cnf-footer__social">
    <a href="https://www.instagram.com/clubnafealsunachta/" target="_blank">
      <img class="cnf-footer__social-svg" src="/instagram.svg" /></a
    >
    <a
      href="https://www.facebook.com/people/Club-na-Fealsúnachta/61578150433186/"
      target="_blank"
    >
      <img class="cnf-footer__social-svg" src="/facebook.svg" /></a
    >
    <a href="https://www.meetup.com/clubnafealsunachta/" target="_blank">
      <img class="cnf-footer__social-svg" src="/meetup.svg" /></a
    >
  </div>

  <div class="cnf-footer__sign">
    Club na Fealsúnachta &#183; {year}
  </div>
</footer>
