---
import { formatBlogDate } from "../utils/script";
const { url, post } = Astro.props;
---

<style>
  li {
    list-style-type: none;
  }

  .cnf-post {
    margin-bottom: 1.75rem;
  }

  .cnf-post__date {
    display: block;
    padding-top: 0.5rem;
  }

  h2 {
    margin: 0;
  }
</style>

<li>
  <article class="cnf-post">
    <a href={url}>
      <h2>{post.title}</h2>
    </a>
    <span class="cnf-post__date">{formatBlogDate(post.date)}</span>
  </article>
</li>
