---
import { formatBlogDate } from "../utils/script";
const { url, data } = Astro.props;
---

<style>
  li {
    list-style-type: none;
  }

  li:last-child {
    border-bottom: none;
  }

  .cnf-blog__post {
    margin-bottom: 1.75rem;
  }

  .cnf-blog__date {
    display: block;
    padding-top: 0.5rem;
  }

  h2 {
    margin: 0;
  }

  /* @media (min-width: 420px) {
    .cnf-blog__post {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
  } */
</style>

<li>
  <article class="cnf-blog__post">
    <a href={url}>
      <h2>{data.title}</h2>
    </a>
    <span class="cnf-blog__date">{formatBlogDate(data.date)}</span>
  </article>
</li>
